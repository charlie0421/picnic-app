#!/usr/bin/env bash
# release_picnic.sh 테스트용 git. 지정한 원격 호출만 실패시키고 나머지는 진짜 git($REAL_GIT)에 넘긴다.
#   FAKE_GIT_FAIL_FETCH=1         fetch 를 실패시킨다
#   FAKE_GIT_FAIL_LS_REMOTE_AT=N  N 번째 ls-remote 를 실패시킨다(호출 수는 $FAKE_GIT_STATE/ls-remote)
# 실패를 주입하면 $FAKE_GIT_STATE/injected 를 만든다.
: "${REAL_GIT:?}" "${FAKE_GIT_STATE:?}"
case "${1:-}" in
  fetch)
    if [ -n "${FAKE_GIT_FAIL_FETCH:-}" ]; then
      : > "$FAKE_GIT_STATE/injected"; echo "fake git: fetch failed" >&2; exit 1
    fi ;;
  ls-remote)
    if [ -n "${FAKE_GIT_FAIL_LS_REMOTE_AT:-}" ]; then
      n=$(( $(cat "$FAKE_GIT_STATE/ls-remote" 2>/dev/null || echo 0) + 1 ))
      echo "$n" > "$FAKE_GIT_STATE/ls-remote"
      if [ "$n" -eq "$FAKE_GIT_FAIL_LS_REMOTE_AT" ]; then
        : > "$FAKE_GIT_STATE/injected"; echo "fake git: ls-remote failed" >&2; exit 128
      fi
    fi ;;
esac
exec "$REAL_GIT" "$@"
