# Uncomment this line to define a global platform for your project
platform :ios, '15.4'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# 소스 저장소
source 'https://cdn.cocoapods.org/' # ✅ 최우선 등록
source 'https://github.com/bytedance/cocoapods_sdk_source_repo.git'
source 'https://github.com/getsentry/sentry-cocoa.git'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    puts "⚠️  #{generated_xcode_build_settings_path} not found. Running Flutter setup to generate it..."
    # Ensure Flutter tool has the artifacts and dependencies to generate iOS configs
    system("cd .. && flutter packages pub get")
    system("cd .. && flutter precache --ios")
    system("cd .. && flutter build ios --config-only")

    # Re-check after generation attempt
    unless File.exist?(generated_xcode_build_settings_path)
      raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
    end
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # 정적 프레임워크 링크로 전환하여 시뮬레이터에서의 Swift 오버레이 dylib 의존을 최소화
  use_frameworks! :linkage => :static
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Pangle SDK는 gma_mediation_pangle 어댑터가 자동 관리
  # pod 'Ads-Global', '6.5.0.9'  # 미디에이션 전환으로 제거
  # Ensure WeChat SDK headers are integrated for fluwx
  pod 'WechatOpenSDK-XCFramework'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Force arm64 simulator, exclude legacy sim archs
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 x86_64'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.4'

      # Meta Audience Network adapter 6.9.0.0+ requires Swift library paths
      # https://developers.google.com/admob/ios/mediation/meta
      config.build_settings['LIBRARY_SEARCH_PATHS'] ||= ['$(inherited)']
      config.build_settings['LIBRARY_SEARCH_PATHS'] << '$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)'
      config.build_settings['LIBRARY_SEARCH_PATHS'] << '$(SDKROOT)/usr/lib/swift'

      # Swift 5 모드 강제 (Xcode 16 호환성)
      config.build_settings['SWIFT_VERSION'] = '5.0'
    end
  end

end

install! 'cocoapods', warn_for_unused_master_specs_repo: false
